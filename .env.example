# ============================================================
# QORA — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# -------------------------------------------------------
# SITE
# -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://qora.ai

# -------------------------------------------------------
# WHATSAPP (Public — used for click-to-chat links only)
# Format: country code + number, no spaces, no +
# -------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=51958226909

# -------------------------------------------------------
# ANALYTICS — Google Tag Manager
# Get from: tagmanager.google.com
# -------------------------------------------------------
NEXT_PUBLIC_GTM_ID=

# -------------------------------------------------------
# ANALYTICS — Google Analytics 4 (optional, can use GTM)
# Get from: analytics.google.com
# -------------------------------------------------------
NEXT_PUBLIC_GA4_ID=

# -------------------------------------------------------
# ANALYTICS — Meta Pixel (future — for ads)
# Get from: business.facebook.com
# -------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=

# -------------------------------------------------------
# LEAD STORAGE — Webhook (Zapier, Make, n8n, etc.)
# POST request with lead JSON will be sent here
# -------------------------------------------------------
LEADS_WEBHOOK_URL=

# -------------------------------------------------------
# WHATSAPP CLOUD API (Future — server-side only)
# Required when moving from link-based to automated responses
# Get from: developers.facebook.com/apps
# -------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_URL=

# -------------------------------------------------------
# BOTPRESS (Future — AI agent platform)
# Required when integrating Botpress flows
# -------------------------------------------------------
BOTPRESS_WEBHOOK_URL=
BOTPRESS_API_KEY=

# -------------------------------------------------------
# DATABASE (Future — when moving to SaaS)
# PostgreSQL recommended for multi-tenant architecture
# -------------------------------------------------------
DATABASE_URL=

# -------------------------------------------------------
# SECURITY
# -------------------------------------------------------
# API_SECRET_KEY=   # For internal API authentication (future)
